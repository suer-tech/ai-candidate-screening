{
  "schemaVersion": "1.1",
  "contractId": "canonical-candidate-e2e-control",
  "requiredCapabilities": [
    "fixtureSeed",
    "processingObservation",
    "artifactInspection",
    "personalMyDriveFixture",
    "controlledRouterAi",
    "matrixDrivenAssessment",
    "observedEvidenceChecks",
    "requirementsBasisGuard",
    "realAssemblyAi",
    "pdfPublication",
    "telegramRecipients",
    "uniqueRunIdentities",
    "crossHrAccess",
    "inputVersioningMatrix",
    "failureMatrix",
    "comparisonMatrix",
    "immutabilityMatrix",
    "archiveLifecycle",
    "protectedTraceInspection",
    "completeCleanup",
    "driveCleanup"
  ],
  "endpoints": [
    { "method": "POST", "path": "/preflight", "purpose": "Fail closed unless the caller and control plane use the exact synchronized main-specs requirements basis; then attest exact build/config, immutable fixture digest, capabilities, controlled RouterAI and real-provider smoke." },
    { "method": "POST", "path": "/runs", "purpose": "Create an isolated run with a caller-supplied unique prefix." },
    { "method": "POST", "path": "/runs/{runId}/vacancy", "purpose": "Bind the explicitly approved UI-created vacancy/version to the run." },
    { "method": "POST", "path": "/runs/{runId}/candidates", "purpose": "Provision immutable synthetic inputs in the connected personal My Drive root." },
    { "method": "GET", "path": "/runs/{runId}", "purpose": "Observe milestones, terminal product failure and result version." },
    { "method": "GET", "path": "/runs/{runId}/evidence/vacancy", "purpose": "Read safe vacancy, identity, Drive and consumer-matrix evidence." },
    { "method": "GET", "path": "/runs/{runId}/evidence/transcript", "purpose": "Read safe FFmpeg/AssemblyAI/transcript/role-map evidence." },
    { "method": "GET", "path": "/runs/{runId}/evidence/abc", "purpose": "Read safe document/OCR/evidence/ABC PDF evidence." },
    { "method": "GET", "path": "/runs/{runId}/evidence/result", "purpose": "Read safe final PDF/recommendation/Telegram evidence." },
    { "method": "GET", "path": "/runs/{runId}/evidence/versioning", "purpose": "Execute frozen-input, rename/move/copy, Results exclusion and manual rerun matrix." },
    { "method": "GET", "path": "/runs/{runId}/evidence/failure-matrix", "purpose": "Execute completeness, permanent/transient error, timeout/retry and notification failure matrix." },
    { "method": "GET", "path": "/runs/{runId}/evidence/comparison", "purpose": "Execute two/three candidate comparison and incompatible vacancy/profile cases." },
    { "method": "GET", "path": "/runs/{runId}/evidence/lifecycle", "purpose": "Execute archive/restore, result immutability and tombstone guard cases." },
    { "method": "GET", "path": "/runs/{runId}/evidence/run", "purpose": "Read build/config identity, provenance, timestamps, monotonic timings and safe evidence metadata." },
    { "method": "POST", "path": "/runs/{runId}/evidence/report-publication", "purpose": "Execute same-checksum reuse and occupied-path conflict without overwriting." },
    { "method": "POST", "path": "/runs/{runId}/cleanup", "purpose": "Remove source and all derived/provider data and attest complete cleanup." }
  ],
  "responseRules": {
    "deriveEvidenceFromDeployedState": true,
    "hardCodedSuccessForbidden": true,
    "booleanSelfAttestationsForbidden": true,
    "staticSourceInspectionForbidden": true,
    "everyCheckRequiresObservedAtUtc": true,
    "everyCheckRequiresArtifactRefs": true,
    "artifactReferenceSchemes": ["postgresql", "my-drive", "provider", "http", "browser", "pdf", "outbox", "trace"],
    "requirementsBasisMustBeSynchronized": true,
    "unsynchronizedDeviationBlocksProductionAcceptance": true,
    "requirementsBasisIsNotProductEvidence": true,
    "terminalFailedMustBeObservable": true,
    "rawPersonalTextForbidden": true,
    "secretsForbidden": true,
    "recipientIdsForbidden": true,
    "rawPromptsAndProtectedTracesForbidden": true
  }
}
