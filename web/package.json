{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "tsx scripts/run-runtime-process.ts web",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:acceptance && npm run test:changes && npm run test:auth && npm run test:theme && npm run test:abc && npm run test:product && npm run test:server-product && npm run test:ui && npm run test:transcription && npm run test:llm && npm run test:agent-runtime:focused && npm run test:canonical-pipeline && npm run test:e2e-harness",
    "test:acceptance": "node --test tests/vacancy-abc-profile.acceptance.test.mjs",
    "test:abc": "tsx --test app/abc-profile-validation.test.ts",
    "test:ui": "node --test tests/vacancy-abc-profile.ui.test.mjs",
    "test:transcription": "tsx --test server/transcription/transcription.test.ts",
    "test:changes": "node --test tests/vacancy-operator-flow-v2.acceptance.test.mjs tests/vacancy-lifecycle.acceptance.test.mjs tests/candidate-lifecycle-controls.acceptance.test.mjs tests/in-app-report-preview.acceptance.test.mjs tests/operational-dashboard.acceptance.test.mjs tests/protected-llm-tracing.acceptance.test.mjs tests/personal-google-drive-oauth.acceptance.test.mjs tests/personal-google-drive-oauth-ui.acceptance.test.mjs && npm run test:vacancy-generation:canonical && npm run test:editable-vacancy-prompts",
    "test:personal-drive-oauth": "node --test tests/personal-google-drive-oauth.acceptance.test.mjs tests/personal-google-drive-oauth-ui.acceptance.test.mjs",
    "test:personal-drive-oauth:evidence": "node tests/personal-google-drive-oauth.evidence.mjs --output tests/acceptance/evidence/personal-google-drive-oauth-red.json",
    "test:vacancy-creation:red": "node --test tests/revise-vacancy-creation-flow.acceptance.test.mjs",
    "test:vacancy-creation:evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/revise-vacancy-creation-flow-red.junit.xml tests/revise-vacancy-creation-flow.acceptance.test.mjs",
    "test:vacancy-creation": "node --test tests/revise-vacancy-creation-flow.acceptance.test.mjs",
    "test:vacancy-creation:green-evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/revise-vacancy-creation-flow-green.junit.xml tests/revise-vacancy-creation-flow.acceptance.test.mjs",
    "test:vacancy-generation:canonical": "tsx --test tests/generated-vacancy-profile.acceptance.test.ts",
    "test:reports:executive-readthrough": "tsx --test tests/executive-report-and-result-readthrough.acceptance.test.ts",
    "test:reports:executive-readthrough:red-evidence": "tsx --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/executive-report-and-result-readthrough-red.junit.xml tests/executive-report-and-result-readthrough.acceptance.test.ts",
    "test:assessment-prompt:bounded": "tsx --test tests/bounded-assessment-prompt.acceptance.test.ts",
    "test:assessment-prompt:bounded:red-evidence": "tsx --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/bounded-assessment-prompt-red.junit.xml tests/bounded-assessment-prompt.acceptance.test.ts",
    "test:manual-reprocess-discovery": "tsx --test tests/manual-reprocess-discovery.acceptance.test.mjs",
    "test:manual-reprocess-discovery:red-evidence": "tsx --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/manual-reprocess-discovery-red.junit.xml tests/manual-reprocess-discovery.acceptance.test.mjs",
    "test:ready-detail-compact-reports": "tsx --test tests/ready-candidate-and-compact-reports.acceptance.test.ts",
    "test:candidate-review-detail": "node --test tests/candidate-review-detail.acceptance.test.mjs",
    "test:candidate-review-detail:red-evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/candidate-review-detail-red.junit.xml tests/candidate-review-detail.acceptance.test.mjs",
    "test:ready-detail-compact-reports:red-evidence": "tsx --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/ready-detail-compact-reports-red.junit.xml tests/ready-candidate-and-compact-reports.acceptance.test.ts",
    "test:vacancy-flow:v2": "node --test tests/vacancy-operator-flow-v2.acceptance.test.mjs",
    "test:vacancy-flow:v2:red-evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/vacancy-operator-flow-v2-red.junit.xml tests/vacancy-operator-flow-v2.acceptance.test.mjs",
    "test:vacancy-generation:canonical:red-evidence": "tsx --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/generated-vacancy-profile-red.junit.xml tests/generated-vacancy-profile.acceptance.test.ts",
    "test:vacancy-generation:routerai:red-evidence": "tsx --test --test-name-pattern=RouterAI --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/routerai-generated-shape-red.junit.xml tests/generated-vacancy-profile.acceptance.test.ts",
    "test:vacancy-generation:result-image:red-evidence": "tsx --test --test-name-pattern=VAC-044 --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/routerai-result-image-layout-red.junit.xml tests/generated-vacancy-profile.acceptance.test.ts",
    "test:editable-vacancy-prompts": "node --import tsx --test tests/editable-vacancy-prompts.acceptance.test.mjs",
    "test:editable-vacancy-prompts:red": "node tests/editable-vacancy-prompts.evidence.mjs --output tests/acceptance/evidence/editable-vacancy-prompts-red.json",
    "test:editable-vacancy-prompts:red-evidence": "node --import tsx --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/editable-vacancy-prompts-red.junit.xml tests/editable-vacancy-prompts.acceptance.test.mjs",
    "test:editable-vacancy-prompts:green-evidence": "node --import tsx --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/editable-vacancy-prompts-green.junit.xml tests/editable-vacancy-prompts.acceptance.test.mjs",
    "test:editable-vacancy-prompts:green-json": "node tests/editable-vacancy-prompts.evidence.mjs --output tests/acceptance/evidence/editable-vacancy-prompts-green.json",
    "test:editable-vacancy-template:red": "node --import tsx --test --test-name-pattern=server-rendered tests/editable-vacancy-prompts.acceptance.test.mjs",
    "test:editable-vacancy-template:red-evidence": "node --import tsx --test --test-name-pattern=server-rendered --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/editable-vacancy-template-red.junit.xml tests/editable-vacancy-prompts.acceptance.test.mjs",
    "test:editable-vacancy-template:red-json": "node tests/editable-vacancy-prompts.evidence.mjs --scenario VAC-040-server-rendered-visible-generation-template --output tests/acceptance/evidence/editable-vacancy-template-red.json",
    "test:auth": "tsx --test server/auth/password.test.ts && node --test tests/email-password-auth.acceptance.test.mjs",
    "test:auth:postgres": "tsx --test server/auth/service.integration.test.ts",
    "test:auth:red-evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/email-password-login-red.junit.xml tests/email-password-auth.acceptance.test.mjs",
    "test:auth:green-evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/email-password-login-green.junit.xml tests/email-password-auth.acceptance.test.mjs",
