{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:acceptance && npm run test:changes && npm run test:theme && npm run test:abc && npm run test:product && npm run test:server-product && npm run test:ui && npm run test:transcription && npm run test:llm && npm run test:e2e-harness",
    "test:acceptance": "node --test tests/vacancy-abc-profile.acceptance.test.mjs",
    "test:abc": "tsx --test app/abc-profile-validation.test.ts",
    "test:ui": "node --test tests/vacancy-abc-profile.ui.test.mjs",
    "test:transcription": "tsx --test server/transcription/transcription.test.ts",
    "test:changes": "node --test tests/revise-vacancy-creation-flow.acceptance.test.mjs tests/candidate-lifecycle-controls.acceptance.test.mjs tests/in-app-report-preview.acceptance.test.mjs tests/operational-dashboard.acceptance.test.mjs tests/protected-llm-tracing.acceptance.test.mjs",
    "test:product": "tsx --test app/product-model.test.ts",
    "test:theme": "tsx --test app/theme-preference.test.ts && node --test tests/theme-preference.acceptance.test.mjs",
    "test:server-product": "tsx --test server/product/application.test.ts server/product/d1-schema.test.ts",
    "test:llm": "tsx --test server/llm/llm.test.ts",
    "test:e2e-harness": "tsx --test server/readiness/e2e-preflight.test.ts && node --test tests/e2e/config.test.mjs",
    "e2e:install": "playwright install chromium",
    "e2e:preflight": "node tests/e2e/preflight.mjs",
    "e2e:required": "playwright test --config tests/e2e/playwright.config.mjs",
    "transcribe:candidate": "tsx server/transcription/cli.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "assemblyai": "^4.36.7",
    "drizzle-orm": "0.45.2",
    "ffmpeg-static": "^5.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
