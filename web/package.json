    "test:theme": "tsx --test app/theme-preference.test.ts && node --test tests/theme-preference.acceptance.test.mjs",
    "test:server-product": "tsx --test server/product/application.test.ts",
    "test:llm": "tsx --test server/llm/llm.test.ts",
    "test:e2e-harness": "node --test tests/vps-postgres-runtime.acceptance.test.mjs tests/ubuntu-deployment.test.mjs tests/e2e/config.test.mjs tests/e2e/control-contract.test.mjs",
    "test:canonical-pipeline:red": "node --test tests/canonical-candidate-pipeline.acceptance.test.mjs",
    "test:canonical-pipeline": "tsx --test server/candidate-pipeline/*.test.ts && node --test tests/canonical-candidate-pipeline.acceptance.test.mjs && npm run test:production-discovery",
    "test:canonical-pipeline:green-evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/canonical-pipeline-local-green.junit.xml tests/canonical-candidate-pipeline.acceptance.test.mjs",
    "test:production-discovery": "node --import tsx --test tests/production-drive-discovery-worker.acceptance.test.mjs",
    "test:production-discovery:red-evidence": "node --test --test-reporter=junit --test-reporter-destination=tests/acceptance/evidence/production-drive-discovery-worker-red.junit.xml tests/production-drive-discovery-worker.acceptance.test.mjs",
    "test:agent-runtime": "tsx --test server/agent-runtime/runtime.test.ts server/agent-runtime/agent-runtime-schema.test.ts && node --test tests/agent-runtime.acceptance.test.mjs",
    "test:agent-runtime:focused": "tsx --test server/agent-runtime/runtime.test.ts server/agent-runtime/agent-runtime-schema.test.ts server/agent-runtime/consumer.test.ts",
    "e2e:install": "playwright install chromium",
    "e2e:preflight": "node tests/e2e/preflight.mjs",
    "e2e:required": "playwright test --config tests/e2e/playwright.config.mjs",
    "e2e:canonical:local-red": "node tests/e2e/canonical-local-baseline.mjs --output tests/acceptance/evidence/canonical-pipeline-local-red.json",
    "service:fixture-controller": "tsx scripts/run-runtime-process.ts controller",
    "service:agent-worker": "tsx scripts/run-runtime-process.ts worker",
    "service:media-processor": "tsx scripts/run-runtime-process.ts media",
    "service:document-processor": "tsx scripts/run-runtime-process.ts document",
    "preflight:runtime": "tsx scripts/runtime-preflight.ts",
    "test:services": "tsx --test server/e2e-controller/controller.test.ts server/agent-runtime/http-tool-adapter.test.ts server/candidate-pipeline/tool-executor.test.ts",
    "test:media-processor": "tsx --test server/media-processor/server.test.ts",
    "test:document-processor": "tsx --test server/document-processor/server.test.ts",
    "transcribe:candidate": "tsx server/transcription/cli.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "tsx scripts/postgres-migrate.ts",
    "check:google-drive": "tsx scripts/check-google-drive.ts",
    "smoke:google-drive": "tsx scripts/smoke-google-drive.ts",
    "smoke:assemblyai": "tsx scripts/smoke-assemblyai.ts",
    "smoke:telegram": "tsx scripts/smoke-telegram.ts",
    "generate:google-oauth-keyring": "tsx scripts/generate-google-oauth-keyring.ts",
    "rotate:google-oauth-keyring": "tsx scripts/generate-google-oauth-keyring.ts --rotate",
    "generate:internal-service-tokens": "tsx scripts/generate-internal-service-tokens.ts",
    "rotate:internal-service-tokens": "tsx scripts/generate-internal-service-tokens.ts --rotate",
    "db:migrate": "tsx scripts/postgres-migrate.ts",
    "auth:create": "tsx scripts/auth-user.ts create",
    "auth:reset": "tsx scripts/auth-user.ts reset",
    "auth:enable": "tsx scripts/auth-user.ts enable",
    "auth:disable": "tsx scripts/auth-user.ts disable",
    "auth:revoke": "tsx scripts/auth-user.ts revoke",
    "postgres:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 up",
    "postgres:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 down",
    "config:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-local-configuration.ps1",
    "security:sentinel": "tsx scripts/security-sentinel-scan.ts",
    "build:id": "tsx scripts/source-build-id.ts",
    "build:pin-local": "tsx scripts/pin-local-build-id.ts",
    "test:private-benchmark": "tsx --test scripts/private-benchmark-firewall.test.ts",
    "local:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/local/local.ps1 bootstrap",
    "local:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/local/local.ps1 check",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/local/local.ps1 start",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/local/local.ps1 status",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../deploy/local/local.ps1 stop",
    "test:vps-postgres": "node --test tests/vps-postgres-runtime.acceptance.test.mjs",
    "test:postgres-integration": "tsx --test server/google-drive-oauth/postgres-repository.integration.test.ts server/google-drive-oauth/my-drive-adapter.test.ts server/storage/private-temp.test.ts server/candidate-pipeline/production-runtime.integration.test.ts server/candidate-pipeline/matrix-postgres-repository.integration.test.ts"
  },
