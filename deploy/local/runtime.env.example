# Единственный локальный non-secret config: скопировать в web/.runtime/runtime.env.
# Ровно восемь secret-файлов лежат только в web/.runtime/credentials/.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
INTERNAL_APP_ORIGIN=http://127.0.0.1:3000
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10
AUTH_MODE=postgres-password
GOOGLE_OAUTH_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/google-drive/oauth/callback
GOOGLE_OAUTH_DEPLOYMENT_MODE=production-personal
ROUTERAI_ENDPOINT=https://routerai.ru/api/v1/chat/completions
ROUTERAI_MODEL=openai/gpt-5.6-sol
ROUTERAI_STRUCTURED_OUTPUTS=true
ROUTERAI_CONTEXT_WINDOW_TOKENS=128000
MATRIX_BATCH_SAFETY_TOKENS=4096
LLM_RELEASE_VERSION=routerai-v1
AGENT_RUNTIME_ENVIRONMENT=local
AGENT_RUNTIME_WORKER_ID=local-worker-1
AGENT_RUNTIME_POLLING_MS=500
AGENT_RUNTIME_HEARTBEAT_MS=5000
AGENT_RUNTIME_LEASE_MS=30000
CANDIDATE_TOOL_EXECUTION_MODE=production
CANDIDATE_PIPELINE_ROUTING=effectful
CANDIDATE_PIPELINE_BUILD_ID=local-unprovisioned
MEDIA_PROCESSOR_URL=http://127.0.0.1:4311/v1/extract-audio
MEDIA_PROCESSOR_HOST=127.0.0.1
MEDIA_PROCESSOR_PORT=4311
MEDIA_PROCESSOR_MAX_INPUT_BYTES=1073741824
DOCUMENT_PROCESSOR_URL=http://127.0.0.1:4312/v1/extract-document
DOCUMENT_PROCESSOR_HOST=127.0.0.1
DOCUMENT_PROCESSOR_PORT=4312
DOCUMENT_PROCESSOR_MAX_INPUT_BYTES=67108864
E2E_ENVIRONMENT=local
E2E_FIXTURE_SET_ID=local-canonical-v1
E2E_ALLOW_DESTRUCTIVE_CLEANUP=false
FIXTURE_CONTROLLER_PORT=4310
FIXTURE_CONTROLLER_STATE_PATH=.runtime/fixture-controller.sqlite
