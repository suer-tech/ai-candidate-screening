# HH AI-screener — nginx reverse proxy для docker VPS deployment.
# Проксирует на web-контейнер по имени сервиса, терминирует TLS,
# basic auth поверх первичного заголовка идентичности.
# HH_DOMAIN подставляется nginx entrypoint из /etc/nginx/templates/*.template.

server {
    listen 8080;
    server_name _;
    access_log off;
    location = /stub_status {
        stub_status;
    }
    location / {
        return 404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${HH_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${HH_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${HH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${HH_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 32m;
    # Не сохраняем request URI: он может содержать идентификаторы кандидатов.
    access_log off;

    # Docker assigns a new IP when the web container is recreated. Resolve the
    # service name through Docker DNS instead of retaining the startup-time IP.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Единственная внешняя monitoring boundary: только OCR VPS + bearer token,
    # который дополнительно проверяет ops-gateway. Grafana/Prometheus/Loki наружу не публикуются.
    location ^~ /api/ops/ {
        allow ${HH_OPS_ALLOWED_IP};
        deny all;
        rewrite ^/api/ops/(.*)$ /$1 break;
        set $ops_upstream ops-gateway:4313;
        proxy_pass http://$ops_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 15s;
    }

    location / {
        set $web_upstream web:3000;
        proxy_pass http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        # Аутентификацией управляет приложение; legacy identity headers от клиента очищаются.
        proxy_set_header oai-authenticated-user-id "";
        proxy_set_header oai-authenticated-user-email "";
        proxy_set_header oai-authenticated-user-full-name "";
        proxy_read_timeout 120s;
    }
}
