# docker compose переменные для HH AI-screener.
# Скопируйте в deploy/docker/.env и заполните. НЕ коммитьте реальные значения
# (файл .env игнорируется git).

# Обязательно
HH_POSTGRES_PASSWORD=change-me-strong-postgres-password

# Локальный запуск (docker-compose.local.yml)
# CANDIDATE_PIPELINE_BUILD_ID=local-docker
# CANDIDATE_PIPELINE_ROUTING=disabled
# HH_CONFIG_ROOT=../../web/.runtime   # по умолчанию уже указывает на web/.runtime

# VPS запуск (docker-compose.vps.yml)
# HH_DOMAIN=hire.example.org
# HH_CONFIG_ROOT=/etc/hh-agent
# E2E_FIXTURE_CONTROL_TOKEN=change-me-e2e-token
# CANDIDATE_PIPELINE_ROUTING=effectful
# RabbitMQ password is read from /config/credentials/rabbitmq-password, not this file.

# RabbitMQ worker capacity. VPS defaults to two consumer containers per queue,
# five unacked deliveries per consumer and ten active tasks per routing class.
# The per-run limit keeps one candidate from occupying the entire pool.
# RABBITMQ_MAX_PER_RUN=2
# RABBITMQ_CONTROL_REPLICAS=2
# RABBITMQ_DOCUMENTS_REPLICAS=2
# RABBITMQ_MEDIA_REPLICAS=2
# RABBITMQ_TRANSCRIPTION_REPLICAS=2
# RABBITMQ_LLM_REPLICAS=2
# RABBITMQ_REPORTS_REPLICAS=2
# RABBITMQ_DRIVE_REPLICAS=2
# RABBITMQ_NOTIFICATIONS_REPLICAS=2
# RABBITMQ_CONTROL_PREFETCH=5
# RABBITMQ_DOCUMENTS_PREFETCH=5
# RABBITMQ_MEDIA_PREFETCH=5
# RABBITMQ_TRANSCRIPTION_PREFETCH=5
# RABBITMQ_LLM_PREFETCH=5
# RABBITMQ_REPORTS_PREFETCH=5
# RABBITMQ_DRIVE_PREFETCH=5
# RABBITMQ_NOTIFICATIONS_PREFETCH=5
# RABBITMQ_CONTROL_CONCURRENCY=10
# RABBITMQ_DOCUMENTS_CONCURRENCY=10
# RABBITMQ_MEDIA_CONCURRENCY=10
# RABBITMQ_TRANSCRIPTION_CONCURRENCY=10
# RABBITMQ_LLM_CONCURRENCY=10
# RABBITMQ_REPORTS_CONCURRENCY=10
# RABBITMQ_DRIVE_CONCURRENCY=10
# RABBITMQ_NOTIFICATIONS_CONCURRENCY=10
