# docker compose переменные для HH AI-screener.
# Скопируйте в deploy/docker/.env и заполните. НЕ коммитьте реальные значения
# (файл .env игнорируется git).

# Обязательно
HH_POSTGRES_PASSWORD=change-me-strong-postgres-password

# Локальный запуск (docker-compose.local.yml)
# CANDIDATE_PIPELINE_BUILD_ID=local-docker
# CANDIDATE_PIPELINE_ROUTING=disabled
# HH_CONFIG_ROOT=../../web/.runtime   # по умолчанию уже указывает на web/.runtime

# VPS запуск (docker-compose.vps.yml)
# HH_DOMAIN=hire.example.org
# HH_CONFIG_ROOT=/etc/hh-agent
# E2E_FIXTURE_CONTROL_TOKEN=change-me-e2e-token
