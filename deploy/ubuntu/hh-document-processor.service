[Unit]
Description=HH private PDF and DOCX document processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hh-agent
Group=hh-agent
WorkingDirectory=/opt/hh-agent/current/web
Environment=HH_RUNTIME_CONFIG_ROOT=/etc/hh-agent
ExecStart=/usr/bin/npm run service:document-processor
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hh-agent /var/log/hh-agent
MemoryMax=2G

[Install]
WantedBy=multi-user.target
