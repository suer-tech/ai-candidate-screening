[Unit]
Description=Encrypted HH PostgreSQL backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=hh-backup
Group=hh-backup
ExecStart=/usr/local/sbin/hh-postgres-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/hh-agent
